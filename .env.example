# Supabase-Projekt (EU/Frankfurt anlegen). Beide Werte stehen im Supabase-Dashboard
# unter Project Settings → API. Der anon-Key darf öffentlich sein: er kommt nur
# durch RLS hindurch, die Zugriffsregeln liegen in der Datenbank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret Key (sb_secret_…). Umgeht RLS komplett: NIEMALS im Browser verwenden und
# nicht bei Vercel als NEXT_PUBLIC_* eintragen. In der App genau ein Aufrufer —
# das Löschen des Kontos. Einzeln widerrufbar, ohne die anderen Keys zu drehen.
SUPABASE_SECRET_KEY=
