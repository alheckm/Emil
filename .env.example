# Supabase-Projekt (EU/Frankfurt anlegen). Beide Werte stehen im Supabase-Dashboard
# unter Project Settings → API. Der anon-Key darf öffentlich sein: er kommt nur
# durch RLS hindurch, die Zugriffsregeln liegen in der Datenbank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret Key (sb_secret_…). Umgeht RLS komplett: NIEMALS im Browser verwenden und
# nicht bei Vercel als NEXT_PUBLIC_* eintragen. In der App genau ein Aufrufer —
# das Löschen des Kontos. Einzeln widerrufbar, ohne die anderen Keys zu drehen.
SUPABASE_SECRET_KEY=

# Gemini-API-Key fuer die Bildgenerierung (scripts/mcp/gemini-image.mjs).
# Kostenlos anlegen unter https://aistudio.google.com/apikey — beginnt mit "AIza".
# Nur lokales Werkzeug: die App liest ihn nicht, Vercel braucht ihn nicht.
GEMINI_API_KEY=

# Haushalt-ID, auf die der wöchentliche Rezept-Pflege-Lauf begrenzt ist
# (scripts/rezept-pflege/pflege.mjs). Ohne diesen Wert bricht der Lauf ab,
# statt Rezepte fremder Haushalte an eine KI zu schicken — das wäre eine
# Datenweitergabe, die /datenschutz nicht ankündigt. Die eigene Haushalt-ID
# steht in der Tabelle `households` oder in der Konto-Ansicht der App.
PFLEGE_HOUSEHOLD_ID=
